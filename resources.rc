IDI_ICON1 ICON "app_icon.ico"

#include <windows.h>

// Embed manifest
1 24 "TokenGenerator.manifest"

// Add version info
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Arena.ai"
            VALUE "FileDescription", "Windows Advanced Token Generator"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "TokenGenerator"
            VALUE "LegalCopyright", "Copyright (C) 2026 Arena.ai. All rights reserved."
            VALUE "OriginalFilename", "TokenGenerator.exe"
            VALUE "ProductName", "Windows Token Generator"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
